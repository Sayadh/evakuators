# PostgreSQL connection string
DATABASE_URL="postgresql://evakuators:CHANGE_ME@localhost:5432/evakuators?schema=public"

# Tow truck photos — files on this server's disk, served by nginx at /media/
# (see MediaStorageService and docs/deployment.md § "Image storage").
# MEDIA_DIR must be absolute and writable by the user PM2 runs the backend as,
# and readable by nginx. MEDIA_PUBLIC_URL is that directory's public address,
# no trailing slash — it is written into every new image row.
#   production:  MEDIA_DIR="/var/www/evakuators-media"
#                MEDIA_PUBLIC_URL="https://evakuators.am/media"
#   local dev:   MEDIA_PUBLIC_URL="http://localhost:4002/media" (the backend
#                serves /media itself when nginx is not in front)
MEDIA_DIR="/var/www/evakuators-media"
MEDIA_PUBLIC_URL="https://evakuators.am/media"
# "true" refuses every upload/delete before it touches the disk. Only ever on a
# deploy whose database is a COPY of production's (staging, local) — the
# nightly purge there must not delete production's files. Never on production.
MEDIA_READ_ONLY="false"

# HTTP — 4002 is reserved for the Evakuators backend (3002 is the frontend, do not swap)
# Declares what this machine is, and it is NOT decoration: the destructive dev
# scripts (scripts/create-test-driver.js, scripts/idram-callback.js) refuse to
# run unless this says "development" (or the database is a *_staging one).
#
# On a developer machine set "development". On the SERVER leave it out or set
# "production" — PM2 sets it for the app process either way, and an unset value
# here is what makes those scripts refuse.
NODE_ENV="development"

PORT=4002
# Interface to bind. Loopback by default so nginx is the only entry point —
# see docs/deployment.md "Why the API binds loopback". Set 0.0.0.0 only if the
# API must be reachable without nginx.
HOST=127.0.0.1
# Comma-separated list of allowed origins
CORS_ORIGIN="http://localhost:3002,https://evakuators.am"

# Public site URL — used to build the "Login" button link sent in Telegram
# messages (driver-link-confirmation, OTP code). No trailing slash.
FRONTEND_URL="https://evakuators.am"

# Driver self-service login (Telegram OTP) — see README "Driver login" section
# Bot token from @BotFather (message it, /newbot)
TELEGRAM_BOT_TOKEN="CHANGE_ME"
# Bot username WITHOUT the @, e.g. EvakuatorsBot
TELEGRAM_BOT_USERNAME="CHANGE_ME"
# Random string you invent — Telegram echoes it back on every webhook call so we
# can verify the request really came from Telegram. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET="CHANGE_ME"
# Restricts OUTBOUND driver-bot messages (OTP codes, link/contact notices) to
# specific chat ids — everyone else is silently skipped, no Telegram API call
# made at all. Leave blank (default): unrestricted, i.e. this deployment's
# real behavior. Only ever set this on a deploy that deliberately shares this
# same TELEGRAM_BOT_TOKEN with another environment (staging — see
# docs/deployment.md § "Staging environment") and must not be able to message
# a real driver. Comma-separated numeric chat ids; get your own from
# @userinfobot on Telegram.
TELEGRAM_OUTBOUND_ALLOWED_CHAT_IDS=""
# Signs driver dashboard JWTs — must be long and random. Generate with: openssl rand -hex 32
DRIVER_JWT_SECRET="CHANGE_ME"

# Admin panel login — see README "Admin panel" section.
# Signs admin JWTs (separate secret from DRIVER_JWT_SECRET on purpose — compromising
# one must not compromise the other). Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET="CHANGE_ME"

# Admin 2-factor login + new-registration notifications, via a SEPARATE
# dedicated Telegram bot (do NOT reuse TELEGRAM_BOT_TOKEN above — see
# docs/auth-and-security.md for why). Fully optional: leave blank and admin
# login stays single-factor (email+password only). Once set, create the bot
# with @BotFather, register its webhook (see docs/deployment.md), then run
# `npm run admin:telegram-link -- <admin-email>` and tap the link it prints —
# 2FA turns on automatically for that account the moment it's linked.
ADMIN_TELEGRAM_BOT_TOKEN=""
# Bot username WITHOUT the @
ADMIN_TELEGRAM_BOT_USERNAME=""
# Random string you invent — generate with: openssl rand -hex 32
ADMIN_TELEGRAM_WEBHOOK_SECRET=""
# Comma-separated Telegram numeric chat ids allowed to use this bot at all
# (link, /start, everything else is silently ignored for anyone else — no
# reply, not even to a valid link token). Get your own chat id by messaging
# @userinfobot on Telegram. Leave blank = unrestricted (any valid link token
# still works, same as before this was added).
ADMIN_TELEGRAM_ALLOWED_CHAT_IDS=""

# ── Provider analytics (see docs/analytics.md) ──
# Pepper used to hash visitor ids before storing them, so a database dump can
# never be replayed against a visitor's browser. OPTIONAL: leave blank and it
# falls back to DRIVER_JWT_SECRET above (the same secret already peppers driver
# OTP hashes), so analytics needs no new setup on an existing deployment.
# Set a dedicated value with: openssl rand -hex 32
# WARNING: changing this makes every returning visitor count as a NEW visitor
# from that moment on. Historical aggregates are unaffected.
ANALYTICS_VISITOR_PEPPER=""

# ── Privacy consent (see docs/auth-and-security.md § "Privacy consent") ──
# HMAC key used to hash the client IP on a consent record. The address itself
# is NEVER stored — only HMAC-SHA256(ip, this secret).
# Optional: falls back to DRIVER_JWT_SECRET, so an existing deployment keeps
# recording consent correctly without a new variable. Set a dedicated value
# with: openssl rand -hex 32
# Rotating it only breaks "same IP as last time" comparisons across the
# rotation. It cannot affect who consented, to what, or when.
PRIVACY_CONSENT_IP_SECRET=""

# ── Nearest-evacuator search (see docs/nearest-search.md) ──
# Road distances and driving times for /evakuator, via OpenRouteService.
# Get a free key at https://openrouteservice.org/dev/#/signup. This
# deployment's key is provisioned for 500 requests/day — check your own key's
# real limit rather than assuming the advertised free-tier figure, and update
# ROUTE_ORS_DAILY_QUOTA in backend/src/routing/routing.constants.ts to match
# if it differs. The key is SHARED: the website gets ROUTE_ORS_SITE_DAILY_SHARE
# (100/day; one visitor search = one request, cached), live dispatch gets
# ROUTE_ORS_DISPATCH_DAILY_SHARE (380/day) when DISPATCH_ROUTING_PROVIDER=ors,
# 20 are kept as margin — see docs/nearest-search.md.
#
# OPTIONAL. Blank means no external call is ever made and the search shows
# PostGIS straight-line distances with NO estimated times — which is exactly the
# fallback a routing outage produces, so the page works either way. Set it to
# get «Ճանապարհով՝ մոտ 4.1 կմ» and «Մոտավոր՝ 8 րոպե» instead of «Ուղիղ գծով».
ROUTE_MATRIX_API_KEY=""
# Only for pointing at a self-hosted instance. The default is correct otherwise.
ROUTE_MATRIX_BASE_URL="https://api.openrouteservice.org"

# --- Idram (driver subscription payments) ---------------------------------
#
# Merchant credentials from Idram. Both come from them, not from us:
# IDRAM_REC_ACCOUNT is the IdramID they issue, IDRAM_SECRET_KEY the key the
# callback checksum is built with (see src/idram/idram-checksum.ts).
#
# BOTH OPTIONAL, and blank is the switch for the whole driver-facing feature —
# same convention as ROUTE_MATRIX_API_KEY above. While either is blank:
#   * POST /api/v1/idram/result stays live and answers REFUSED (so the URL can
#     be registered with Idram before the credentials arrive),
#   * the driver's dashboard shows no «Վճարումներ» block and no reminder,
#   * SubscriptionActiveGuard refuses nothing — no paywall, because there is no
#     way to pay,
#   * /admin/payments works in full, including marking a driver paid by hand.
# Setting both turns all of that on with `pm2 restart ecosystem.config.js` — no
# redeploy. See docs/deployment.md.
IDRAM_REC_ACCOUNT=""
IDRAM_SECRET_KEY=""

# WHO sees the payment block and is held to the paywall, once the credentials
# above exist. Separate from them on purpose: Idram issues TEST credentials
# first, against these same production URLs, so the gateway has to be live
# while the driver-facing side is not.
#
#   ""        nobody   (default — nothing changes for any driver)
#   "12,34"   only those TowTruck ids  (the test accounts)
#   "all"     every driver             (the launch)
#
# BLANK MEANS NOBODY, unlike TELEGRAM_OUTBOUND_ALLOWED_CHAT_IDS above. This
# list decides who gets locked out of their own page, so an unset variable has
# to fail closed and going live has to be a word someone typed on purpose —
# the `20260902140000` backfill leaves most existing drivers `overdue`.
#
# NEVER put real credentials in this file: it is COMMITTED and the repository
# is public. They belong in backend/.env (gitignored) locally, and in the
# `env` block of ecosystem.config.js on the server.
SUBSCRIPTIONS_PILOT_TOW_TRUCK_IDS=""

# ─── Live dispatch (docs/live-dispatch/) ────────────────────────────────────
# Every flag is OFF by default. Off = the endpoints answer FEATURE_DISABLED
# and the worker idles; nothing else in the site changes.
LIVE_DISPATCH_ENABLED="false"
DRIVER_TRACKING_ENABLED="false"
LIVE_NEARBY_ENABLED="false"

# Realtime fan-out worker → API (WebSocket). NOT a source of truth: losing
# Redis only delays live screen updates. Blank = in-process (single process,
# development only).
REDIS_URL=""

# Routing for dispatch ETAs: fake | ors | google. "fake" (default) costs
# nothing and calls nobody — keep it for local/staging/load tests.
DISPATCH_ROUTING_PROVIDER="ors"
# SERVER-side Google Maps Platform key with ONLY the Routes API enabled,
# restricted by IP to this server. Never the browser key, never in the app.
GOOGLE_ROUTES_API_KEY=""
# TRAFFIC_UNAWARE (cheapest) | TRAFFIC_AWARE | TRAFFIC_AWARE_OPTIMAL
GOOGLE_ROUTING_PREFERENCE="TRAFFIC_AWARE"
DISPATCH_ROUTING_TIMEOUT_MS="4000"
DISPATCH_ROUTING_RETRIES="1"
DISPATCH_ROUTING_MAX_CONCURRENT="4"
# Dispatch's daily cap on provider REQUESTS (retries included). Blank = with
# ors, its share of the shared key (ROUTE_ORS_DISPATCH_DAILY_SHARE, 380);
# with google/fake, no request cap. Past it: straight-line, never refused.
DISPATCH_ROUTING_DAILY_REQUESTS=""
# Separate daily element budget for the public live search
PUBLIC_NEARBY_DAILY_ELEMENT_BUDGET="5000"
# Public live search's ORS requests/day. Blank with ors = 0 (straight line for
# live entries): the 500 are already split site 100 / dispatch 380 / margin 20.
PUBLIC_NEARBY_DAILY_REQUESTS=""

# Push: recording | fcm. "recording" (default) sends NOTHING — it only logs
# intent. Set fcm ONLY on production after the Firebase project is ready.
PUSH_PROVIDER="recording"
# Firebase service account JSON on ONE line (Project settings → Service
# accounts → Generate new private key). Secret — never commit it.
FCM_SERVICE_ACCOUNT_JSON=""

