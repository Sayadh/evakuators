# Template for staging's backend/.env — see docs/deployment.md § "Staging
# environment" for the full setup. Copy this to backend/.env INSIDE THE
# STAGING CHECKOUT ONLY (e.g. /var/www/evakuators-staging/backend/.env) —
# never onto production's checkout, and never commit the filled-in version
# (this file is a template; the real one stays untracked, same as .env.example).
#
# This file only calls out what differs from — or must be copied from —
# production's backend/.env. See .env.example for what every variable means;
# not repeated here.

# A SEPARATE database on the same Postgres instance is enough — no new
# server, full data isolation. One-time setup:
#   psql postgres -c "CREATE DATABASE evakuators_staging OWNER evakuators;"
DATABASE_URL="postgresql://evakuators:CHANGE_ME@localhost:5432/evakuators_staging?schema=public"

# COPY FROM PRODUCTION verbatim — by deliberate choice (see docs/deployment.md
# § "Staging environment" for why): staging is not getting its own Supabase
# bucket, so test uploads on staging land in the SAME bucket real driver
# photos live in. Acceptable for now; revisit if that ever becomes a problem.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="CHANGE_ME"
SUPABASE_STORAGE_BUCKET="tow-truck-images"

# 4003 is reserved for staging's backend — 3003 is staging's frontend, 4002/3002
# are production's. Never swap any of these.
PORT=4003
HOST=127.0.0.1
CORS_ORIGIN="http://localhost:3002,https://staging.evakuators.am"

FRONTEND_URL="https://staging.evakuators.am"

# COPY FROM PRODUCTION verbatim — same deliberate choice as Supabase above.
# Staging does NOT get its own Telegram bot. Consequence, and it is a real
# one: Telegram has exactly one webhook per bot, globally (see
# docs/local-development.md), and that webhook stays pointed at production's
# URL. So staging's backend can hold the same bot token and still never
# actually RECEIVE a Telegram update — driver OTP login, admin 2FA, and
# new-registration notifications will not fire while testing on staging, the
# same limitation local development already has. Test those specific flows
# against production (carefully — see the warning at the top of
# frontend/.env when it's pointed at the live API) or accept the gap.
TELEGRAM_BOT_TOKEN="CHANGE_ME"
TELEGRAM_BOT_USERNAME="CHANGE_ME"
TELEGRAM_WEBHOOK_SECRET="CHANGE_ME"

# Generate FRESH secrets for staging — do NOT copy these two from production.
# The bot and Storage bucket are intentionally shared above; a driver/admin
# session token is not supposed to be, and a leaked staging JWT secret must
# not be able to forge a valid production session (or the reverse).
# Generate with: openssl rand -hex 32
DRIVER_JWT_SECRET="CHANGE_ME"
ADMIN_JWT_SECRET="CHANGE_ME"

# Optional — same COPY FROM PRODUCTION reasoning as the driver bot above, if
# admin 2FA is being tested at all on staging. Leave blank (as in
# .env.example) to keep admin login single-factor on staging, which is the
# simpler default and avoids the same "message never arrives" gap.
ADMIN_TELEGRAM_BOT_TOKEN=""
ADMIN_TELEGRAM_BOT_USERNAME=""
ADMIN_TELEGRAM_WEBHOOK_SECRET=""
ADMIN_TELEGRAM_ALLOWED_CHAT_IDS=""

# Generate a fresh value, same reasoning as the JWT secrets above — this
# pepper hashes visitor ids, and staging's test traffic has no reason to be
# linkable to production's even indirectly.
ANALYTICS_VISITOR_PEPPER=""
