# Template for staging's backend/.env — see docs/deployment.md § "Staging
# environment" for the full setup. Copy this to backend/.env INSIDE THE
# STAGING CHECKOUT ONLY (e.g. /var/www/evakuators-staging/backend/.env) —
# never onto production's checkout, and never commit the filled-in version
# (this file is a template; the real one stays untracked, same as .env.example).
#
# This file only calls out what differs from — or must be copied from —
# production's backend/.env. See .env.example for what every variable means;
# not repeated here.

# A SEPARATE database on the same Postgres instance — full data isolation,
# no new server. One-time setup:
#   sudo -u postgres psql -c "CREATE DATABASE evakuators_staging OWNER evakuators;"
# Then populated with a real, current copy of production's data via
# scripts/refresh-staging-db.sh (see docs/deployment.md) — never by hand, and
# never by pointing this at production's database directly.
DATABASE_URL="postgresql://evakuators:CHANGE_ME@localhost:5432/evakuators_staging?schema=public"

# COPY FROM PRODUCTION verbatim. Staging deliberately shares production's real
# Supabase project/bucket so that copied TowTruck rows' photos display
# correctly (their URLs are absolute and public — Supabase serves them
# regardless of which app is running) — but see SUPABASE_STORAGE_READ_ONLY
# below, which is what actually keeps staging from ever writing here.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="CHANGE_ME"
SUPABASE_STORAGE_BUCKET="tow-truck-images"

# Blocks every upload/delete at SupabaseStorageService before it reaches the
# network — see that class's own comment for the full reasoning. This is the
# actual enforcement mechanism; sharing the bucket above would otherwise mean
# a driver registering or editing a listing on staging writes into
# PRODUCTION'S real bucket. Leave this "true" on staging. Never set it on
# production's own backend/.env.
SUPABASE_STORAGE_READ_ONLY="true"

# 4003 is reserved for staging's backend — 3003 is staging's frontend, 4002/3002
# are production's. Never swap any of these.
PORT=4003
HOST=127.0.0.1
CORS_ORIGIN="http://localhost:3002,https://staging.evakuators.am"

FRONTEND_URL="https://staging.evakuators.am"

# COPY FROM PRODUCTION verbatim. Staging deliberately shares production's real
# driver bot token, so real Telegram OTP delivery can be tested end-to-end —
# see TELEGRAM_OUTBOUND_ALLOWED_CHAT_IDS below, which is what makes that safe.
#
# The bot's webhook is a separate concept from its token and is NOT affected
# by any of this: it is registered once, manually, with a `curl
# .../setWebhook` call (see docs/deployment.md), stays pointed at production's
# URL, and nothing in this codebase ever calls setWebhook/deleteWebhook —
# staging holding the same token does not move where Telegram delivers
# incoming messages (/start, account-linking) or change production's webhook
# in any way.
TELEGRAM_BOT_TOKEN="CHANGE_ME"
TELEGRAM_BOT_USERNAME="CHANGE_ME"
TELEGRAM_WEBHOOK_SECRET="CHANGE_ME"

# REQUIRED on staging, and this is the actual safety mechanism for sharing the
# bot token above. Without it, testing driver login against a phone number
# that happens to belong to a REAL driver (staging's database is a full copy
# of production's, so their real telegramChatId is right there) would send
# THEM a real "here is your login code" message. Set this to your own numeric
# Telegram chat id (message @userinfobot to get it) — every send to any other
# chat id is silently skipped, no Telegram API call made at all. Leave this
# BLANK on production's own backend/.env; blank means unrestricted.
TELEGRAM_OUTBOUND_ALLOWED_CHAT_IDS="CHANGE_ME_TO_YOUR_OWN_TELEGRAM_CHAT_ID"

# Generate FRESH secrets for staging — do NOT copy these from production.
# The bot token and Storage bucket are intentionally shared above (with the
# guards that make that safe); a driver/admin session token is not supposed
# to be, and a leaked staging JWT secret must not be able to forge a valid
# production session (or the reverse).
# Generate with: openssl rand -hex 32
DRIVER_JWT_SECRET="CHANGE_ME"
ADMIN_JWT_SECRET="CHANGE_ME"

# Left disabled by default on staging — a separate, optional concern from the
# driver bot above. Admin 2FA is not required to boot (see .env.example), so
# the simplest default is to leave it off and admin login stays
# single-factor on staging. If you do want to test it, the same
# COPY-FROM-PRODUCTION + chat-id-allowlist pattern as the driver bot applies,
# but there is no ADMIN equivalent of TELEGRAM_OUTBOUND_ALLOWED_CHAT_IDS
# today — add one the same way before ever setting a real
# ADMIN_TELEGRAM_BOT_TOKEN here.
ADMIN_TELEGRAM_BOT_TOKEN=""
ADMIN_TELEGRAM_BOT_USERNAME=""
ADMIN_TELEGRAM_WEBHOOK_SECRET=""
ADMIN_TELEGRAM_ALLOWED_CHAT_IDS=""

# Generate a fresh value, same reasoning as the JWT secrets above — this
# pepper hashes visitor ids, and staging's test traffic has no reason to be
# linkable to production's even indirectly.
ANALYTICS_VISITOR_PEPPER=""
