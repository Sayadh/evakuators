// Evakuators.am — dynamic business data only.
// Static geography (regions, cities, districts) and static dictionaries
// (service types, vehicle types) live in the FRONTEND as TypeScript constants
// and are referenced here by their slugs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN
}

/// Lifecycle of a driver's proposed edit to their own live profile.
///
/// Deliberately the same three words as RegistrationStatus: a moderator is
/// doing the same job in both queues, and two vocabularies for one workflow is
/// how a status ends up compared against the wrong string.
enum ProfileChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Which flow produced a consent record — see DriverPrivacyConsent.
///
/// An enum rather than a boolean because the two are not opposites of one
/// thing: REGISTRATION is consent given *before* a profile exists, attached to
/// a request that may never be approved, and EXISTING_DRIVER is consent given
/// by someone whose profile has been public for months. Which one a row is
/// changes what it proves, so it must be stored, not inferred from whichever
/// foreign key happens to be null.
enum PrivacyConsentSource {
  /// Ticked in the dialog on /register, stored with the RegistrationRequest
  REGISTRATION
  /// Ticked in the blocking dialog on the dashboard by an already-published
  /// driver — the ~100 who signed up before consent was asked for at all
  EXISTING_DRIVER
}

enum FreeRouteStatus {
  /// Shown on the public listing, still open for a customer to grab
  ACTIVE
  /// Past its departure time — kept briefly for the driver's own history,
  /// then hard-deleted by the cleanup cron (see free-routes.service.ts)
  FINISHED
}

/// Every interaction a visitor can have with a tow truck profile that a driver
/// is allowed to see in their own dashboard. Deliberately a closed enum rather
/// than a free-text event name: the dashboard has one card per value, and a
/// typo'd event name must fail at the DB boundary, not silently create a
/// sixth invisible metric. See docs/analytics.md.
enum AnalyticsEventType {
  /// Visitor opened /tow-trucks/:slug
  PAGE_VIEW
  /// Visitor pressed the "Զանգահարել" button (tel: link)
  PHONE_CLICK
  WHATSAPP_CLICK
  TELEGRAM_CLICK
  EMAIL_CLICK
}

/// Site-wide traffic, for the ADMIN panel — deliberately a separate enum from
/// AnalyticsEventType above, which is per-tow-truck and belongs to a driver.
/// Mixing them would mean one nullable towTruckId column whose null-ness
/// silently changes what every existing query means.
enum SiteEventType {
  /// Any page of the site opened, once per visitor per Armenia day
  SITE_VISIT
  /// The "Ազատ երթուղիներ" page (/free-routes) specifically
  FREE_ROUTES_VIEW
}

model TowTruck {
  id               Int     @id @default(autoincrement())
  slug             String  @unique
  driverName       String
  companyName      String?
  /// The driver-login key: DriverAuthService finds a truck by this exact
  /// string. @unique covers active AND deactivated rows together, because
  /// handing a deactivated truck's freed-up number to a new one would break
  /// silently the moment the old truck is reactivated — two active trucks
  /// sharing one login phone, with findFirst resolving arbitrarily to one of
  /// them. Until this constraint existed the rule lived only in application
  /// code, in four separate check-then-write places, each with a race window.
  ///
  /// No companion @@index([phone]): in Postgres a unique constraint IS a
  /// b-tree index, so a second one would only add write cost.
  ///
  /// The canonical format (+374 followed by 8 digits) is enforced at every
  /// entry point by IsArmenianPhone (src/common/phone.ts). Without that this
  /// constraint would guarantee uniqueness of the string, not of the number.
  phone            String  @unique
  secondaryPhone   String?
  whatsapp         String?
  telegram         String?
  email            String?
  works24Hours     Boolean @default(false)
  /// Free-form hours the driver typed at registration/edit time (e.g. "09:00 – 20:00").
  /// Only meaningful when works24Hours is false — ignored by the API mapper
  /// otherwise. Null means "not specified", in which case the frontend hides
  /// the working-hours line entirely instead of showing a made-up default.
  workingHoursText String?
  description      String

  // Vehicle
  vehicleBrand    String
  vehicleModel    String?
  vehicleYear     Int
  /// VehicleType slug from frontend constants (flatbed, sliding-platform, ...)
  vehicleType     String
  capacityTons    Float
  platformLengthM Float?
  platformWidthM  Float?

  /// Crane rating and reach — asked only of «Մանիպուլյատոր», which is the only
  /// type that has a crane to rate. Null on every other truck and on every row
  /// written before the specialist forms existed; the public profile renders
  /// nothing for a null rather than inventing a zero.
  craneCapacityTons Float?
  craneReachM       Float?

  /// The exact platform tonnage, for the two specialist types only.
  ///
  /// Those two are asked this INSTEAD of the capacity band picker, and
  /// `capacityTons` is written from it verbatim rather than from
  /// `representativeCapacityTons()`. A band is the right question for an
  /// ordinary evacuator (nobody knows their exact rating, and the customer only
  /// needs to know a saloon fits) and the wrong one for a machinery
  /// transporter, where «10 տոննայից ավելի» is the only band that ever applies
  /// and the entire decision is whether a 22-tonne excavator goes on.
  ///
  /// Kept as its own column rather than reusing `capacityTons`: that one is a
  /// derived filter index every truck has, this one is a stated figure only
  /// some trucks have, and only the second may be displayed as a specification.
  maxLoadTons Float?

  /// Deck height in centimetres — whether a low-clearance machine can be driven
  /// onto the platform at all. Asked only of «Ծանր տեխնիկայի էվակուատոր».
  platformLoadHeightCm Float?

  winch           Boolean @default(true)
  manipulator     Boolean @default(false)
  /// Equipment for loading a vehicle whose wheels are locked/won't roll
  /// (e.g. a car with a seized brake or a stolen wheel) safely onto the
  /// platform. Same equipment-boolean shape as winch/manipulator — set once
  /// at registration, not editable from the driver's own dashboard.
  wheelSkates     Boolean @default(false)
  /// A two-tier platform — the truck carries TWO cars at once (one on the
  /// raised upper deck, one below) rather than one.
  ///
  /// Same driver-answered equipment-boolean shape as `wheelSkates`, and asked
  /// of the same two vehicle types for a related reason: it describes how many
  /// CARS fit on the deck, which is only a question for the two ordinary
  /// evacuators. A manipulator lifts one vehicle by crane and a machinery
  /// transporter carries one machine, so neither is ever two-tier (see
  /// `asksDoubleDeck` in frontend/constants/vehicles.ts).
  ///
  /// Unlike `manipulator`, nothing derives this from the vehicle type: there
  /// is no «2-հարկանի» type in the taxonomy, so the checkbox is the only
  /// source and there is no second answer for it to contradict.
  doubleDeck      Boolean @default(false)
  /// A tow hitch — the truck can pull a second car behind it (in tow) at the
  /// same time it carries one on the platform, rather than only the one.
  ///
  /// Same driver-answered equipment-boolean shape as `doubleDeck` right above
  /// (its own column, its own predicate `asksTowHitch` in
  /// frontend/constants/vehicles.ts — not derived from `doubleDeck`, even
  /// though both currently exclude the same two vehicle types: a two-tier
  /// deck and a hitch are two independent ways to answer "how many cars", and
  /// a future vehicle type could plausibly have one without the other).
  towHitch        Boolean @default(false)
  /// Whether this truck can move heavy machinery — what puts it on
  /// `/tsanr-tehnika`. UNLIKE every other boolean here it is NOT a driver
  /// answer: it is set by an admin only (there is no registration field and no
  /// dashboard field for it), because a driver who ticks it wrongly sends a
  /// stranded excavator a truck that cannot lift it.
  ///
  /// UNLIKE `manipulator` this column is NOT derived on write: it stores only
  /// what an admin decided. Who actually appears on `/tsanr-tehnika` is the
  /// union of this and `vehicleType == 'heavy-duty'`, applied on every READ
  /// (`derivesHeavyEquipment` — the listing filter and the admin mapper).
  /// Storing the derived value instead would survive the driver later changing
  /// their vehicle type, leaving a flatbed on an admin-only page.
  heavyEquipment  Boolean @default(false)
  plateNumber     String?
  showPlateNumber Boolean @default(false)

  // Base location — slugs reference frontend static data
  regionSlug   String?
  citySlug     String?
  districtSlug String?
  locationName String

  /// «Ամբողջ Հայաստան» — coverage stated as one decision rather than as a list.
  ///
  /// Only the specialist vehicles are offered it, and only because the coverage
  /// cap (`service-area-limits.ts`) does not apply to them: a crane truck
  /// genuinely does drive the country for a booked job, which is the opposite
  /// of the roadside evacuator the 2/3/5-area budget was written for.
  ///
  /// Deliberately NOT eleven `serviceAreas` rows. "Everywhere" and "all eleven
  /// marzes, ticked one by one" would then be the same stored value, so the
  /// form could never show a driver back the choice they actually made — and
  /// adding a marz would silently shrink the first group's coverage.
  ///
  /// It does NOT replace the base: `regionSlug`/`citySlug`/`locationName` and
  /// the coordinates stay required exactly as before, because "where are you"
  /// and "where will you go" are different questions and the nearest-driver
  /// search only answers the first.
  servesAllArmenia Boolean @default(false)

  /// Where the truck is actually parked, as a point — the input for the
  /// "nearest evacuator to the customer" distance calculation. This is a base
  /// location, NOT live tracking: it changes only when a driver or an admin
  /// edits it.
  ///
  /// Deliberately TWO numeric columns and never one string: a "40.1792,
  /// 44.4991" text column cannot be compared, indexed or fed to a distance
  /// formula without parsing it back out first — the exact mistake
  /// `platformDimensions` made (see RegistrationRequest below). The single
  /// text box on the frontend is a Google-Maps-paste affordance and nothing
  /// more; it is split before it ever leaves the browser.
  ///
  /// Decimal(9,6), not Float: 6 decimal places is ~0.11 m at this latitude,
  /// far finer than a parking spot needs, and an exact decimal type means a
  /// coordinate reads back exactly as it was entered. Precision 9 is the
  /// widest either axis can be (`-180.000000`).
  ///
  /// Nullable, and stays nullable: every driver approved before this feature
  /// existed has none, and a NOT NULL column would have required inventing a
  /// coordinate for each of them.
  ///
  /// Registration does not require it either (see CreateRegistrationDto). It
  /// briefly did, and the cost ran the wrong way: the form is the only route
  /// onto the platform and this is its hardest step, so a driver defeated by it
  /// was lost entirely rather than arriving with one field to fill in later.
  /// Worse, the mandatory version told a stuck driver to paste the example
  /// coordinate, which silently parked them in the centre of Yerevan — a wrong
  /// value nothing downstream can distinguish from a real one. A NULL here is
  /// honest and fixable from the driver's own dashboard.
  ///
  /// Always written and cleared as a PAIR — one axis alone describes no place.
  /// Enforced at every entry point, never by the column.
  latitude          Decimal?  @db.Decimal(9, 6)
  longitude         Decimal?  @db.Decimal(9, 6)
  /// When the coordinate pair above was last written (registration approval,
  /// driver self-edit, or admin correction). Null exactly when both
  /// coordinates are null. Separate from `updatedAt`, which moves on any edit
  /// and so cannot answer "how stale is this driver's location".
  locationUpdatedAt DateTime?

  /// PostGIS projection of latitude/longitude — the index the "nearest
  /// evacuator" search actually reads. `Unsupported` because Prisma has no
  /// geography type; the column is declared here only so schema and database
  /// agree and drift detection stays quiet.
  ///
  /// **Never written from application code, and it cannot be**: it is
  /// `GENERATED ALWAYS ... STORED` in Postgres (see the migration), so the
  /// database recomputes it from the two columns above on every write and an
  /// INSERT that mentioned it would be rejected outright. Prisma also excludes
  /// `Unsupported` fields from the generated client entirely, so there is no
  /// typed path to it either — reads go through raw SQL in
  /// `NearestRepository`.
  ///
  /// Because Prisma cannot express `GENERATED ALWAYS`, `prisma migrate dev`
  /// must never be allowed to regenerate this column: it would emit a plain
  /// `ADD COLUMN` and silently drop the generation clause, leaving a geography
  /// column that is permanently NULL. Migrations here are hand-authored SQL
  /// anyway (see docs/data-model.md § Migrations).
  location Unsupported("geography(Point, 4326)")?

  /// ServiceType slugs from frontend constants
  services     String[]
  /// [{ name, slug, type: "city" | "district" | "region" }]
  serviceAreas Json

  // Pricing — fully optional; missing values are simply not displayed
  priceCityCallout           Int?
  pricePerKm                 Int?
  priceWaitingPerHour        Int?
  priceNightSurchargePercent Int?
  priceExtraLoading          Int?

  isActive   Boolean  @default(true)
  /// Admin-curated "best tow trucks" homepage pick — see FeaturedTowTrucksSection
  /// on the frontend. Purely editorial, has no effect on public search/filter
  /// results elsewhere.
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  images     TowTruckImage[]
  reviews    Review[]
  freeRoutes FreeRoute[]

  /// Edits this driver has proposed to their own profile — see
  /// ProfileChangeRequest. Cascades on delete like everything else here, so
  /// AdminService.deleteTowTruck() needs no extra cleanup step.
  profileChanges ProfileChangeRequest[]

  /// Every time this driver consented to (or withdrew consent for) the
  /// processing and publication of their data — see DriverPrivacyConsent. An
  /// append-only history, not a flag: a driver with no rows here has simply
  /// never been asked, which is exactly true of everyone published before the
  /// dialog existed.
  privacyConsents DriverPrivacyConsent[]

  // Provider analytics — see docs/analytics.md. Both cascade on delete, so
  // AdminService.deleteTowTruck() needs no extra cleanup step.
  analyticsDailyStats  AnalyticsDailyStat[]
  analyticsVisitorDays AnalyticsVisitorDay[]

  /// bcrypt hash of the driver's login password. Paired with `phone`, which
  /// is the lookup key — see DriverAuthService.login().
  ///
  /// Nullable, and it means something specific: a driver who has never tapped
  /// their Telegram link has no password at all and cannot log in. The first
  /// tap is what mints one (TelegramWebhookController.handleStart), which is
  /// also the only channel we have for delivering it — so "no hash" and "never
  /// linked" are two views of the same state rather than two states to
  /// reconcile.
  passwordHash       String?
  /// True while `passwordHash` still holds a password WE generated, false once
  /// the driver has replaced it with their own.
  ///
  /// This is the flag the whole flow turns on, in two places that must agree:
  /// the dashboard refuses to do anything else until it is cleared, and a
  /// Telegram re-link re-issues a password only while it is true. That second
  /// rule is the point — once a driver owns their password, re-linking a
  /// Telegram account (which proves possession of a link, not of an identity —
  /// see docs/auth-and-security.md) must not be a way to reset it.
  ///
  /// Defaults false so every row that existed before this column did reads as
  /// "not holding a temporary password", which is true: they held no password
  /// at all.
  mustChangePassword Boolean @default(false)

  // Telegram — login-code delivery until password login replaced it, now the
  // channel for contact notices and for the one-time password handover.
  /// Telegram numeric chat id, captured once the driver taps the bot deep-link.
  /// Null until linked; until then there is no way to hand them a password.
  telegramChatId             BigInt?   @unique
  /// One-time token embedded in the t.me/<bot>?start=<token> link. Cleared once used.
  telegramLinkToken          String?   @unique
  telegramLinkTokenExpiresAt DateTime?

  /// When the one-time "here is why you get these" explanation was delivered
  /// with the driver's first contact notice (see DriverNotificationService).
  /// Null = never sent. Claimed atomically, which is what guarantees the
  /// explanation rides along with the FIRST notice only and never repeats —
  /// see its comment for the concurrency argument.
  ///
  /// Contact notices themselves are not optional: every linked driver gets
  /// them, there is no per-driver switch.
  contactNoticeIntroAt DateTime?

  @@index([citySlug])
  @@index([districtSlug])
  @@index([regionSlug])
  @@index([isActive])
  @@index([isFeatured])
  /// GIN index on the serviceAreas JSONB, for the `array_contains` half of every
  /// city/district/region listing filter (see TowTrucksRepository.buildWhere).
  /// Without it those queries are a Seq Scan over every tow truck with a JSONB
  /// containment test per row — measured on 20k rows with 5 matches: 5.8ms
  /// Seq Scan vs 0.07ms Bitmap Index Scan. `jsonb_path_ops` (not the default
  /// `jsonb_ops`) because we only ever use the `@>` containment operator, and
  /// it produces a substantially smaller, faster index for exactly that.
  @@index([serviceAreas(ops: JsonbPathOps)], type: Gin)
}

model TowTruckImage {
  id        Int      @id @default(autoincrement())
  /// Storage object path inside the Supabase bucket
  path      String   @unique
  /// Public URL served by Supabase Storage
  url       String
  width     Int
  height    Int
  sizeBytes Int
  position  Int      @default(0)
  createdAt DateTime @default(now())

  towTruckId Int?
  towTruck   TowTruck? @relation(fields: [towTruckId], references: [id], onDelete: Cascade)

  registrationRequestId Int?
  registrationRequest   RegistrationRequest? @relation(fields: [registrationRequestId], references: [id], onDelete: SetNull)

  /// The pending profile edit that wants to add this photo to a gallery.
  ///
  /// A third owner, for exactly the same reason the second one exists: an image
  /// belonging to no truck and no request is an orphan and the nightly purge
  /// deletes it after 24 hours (ImagesService). A driver's photo change can sit
  /// in the moderation queue for longer than that, so without this column the
  /// new photos would be deleted out from under a request nobody had reviewed
  /// yet — and approving it would then fail on images that no longer exist.
  ///
  /// SetNull rather than Cascade: when a change request is deleted the photos
  /// become ordinary orphans and the purge collects them on its own schedule,
  /// which is the one place that deletes a Storage object and a row in the
  /// right order.
  profileChangeRequestId Int?
  profileChangeRequest   ProfileChangeRequest? @relation(fields: [profileChangeRequestId], references: [id], onDelete: SetNull)

  @@index([towTruckId])
  @@index([registrationRequestId])
  @@index([profileChangeRequestId])
}

/// One edit a driver has proposed to their own already-published profile.
///
/// ## Why a request rather than a write
///
/// Everything on a driver's dashboard used to save straight to `TowTruck`.
/// Approval reviewed a listing once, at registration, and after that a driver
/// could raise their stated capacity, add coverage they do not really serve, or
/// rewrite their description to anything at all, and nothing looked at it again
/// — a trade-off `UpdateMyTowTruckDto` documented at the time and pointed at
/// this exact place as where to undo it.
///
/// Now a save queues. The live profile is untouched until a moderator approves,
/// so what the public sees is always something a human has seen.
///
/// ## What is stored, and what is not
///
/// `changes` holds **only the fields that actually differ** from the live
/// profile at the moment of submission — not the whole form. That is what makes
/// the review a diff rather than a re-read of the entire listing: a driver who
/// only fixed a phone number produces a one-key object, and the moderator sees
/// one line. `before` is a snapshot of those same keys as they were, so the
/// panel can render «was → now» without a second query, and so a diff already
/// under review still reads correctly if the live row moves underneath it.
///
/// Both are `Json` because the set of keys is the DTO's, not a table's — giving
/// each field a nullable column would mean ~30 columns that are null for every
/// row, and no way to tell "not changed" from "changed to null".
///
/// ## One pending request per truck
///
/// Enforced by a partial unique index (see the migration), not just by the
/// service: two queued edits to one profile cannot be applied in a defined
/// order, and the second would silently overwrite the first's fields. A driver
/// who saves again while one is pending REPLACES it — same row, new diff — which
/// is also why `createdAt` is refreshed on resubmission.
model ProfileChangeRequest {
  id         Int      @id @default(autoincrement())
  towTruckId Int
  towTruck   TowTruck @relation(fields: [towTruckId], references: [id], onDelete: Cascade)

  status ProfileChangeStatus @default(PENDING)

  /// Only what differs, in `UpdateMyTowTruckDto` shape (plus `latitude`/`longitude`)
  changes Json
  /// The same keys as they were when the driver pressed save
  before  Json

  /// Required when rejecting — the driver is shown this verbatim, in Telegram
  /// and on their dashboard, so "no" is never an unexplained no.
  rejectionReason String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  /// Photos this edit wants to add, kept alive while it waits — see
  /// TowTruckImage.profileChangeRequestId.
  images TowTruckImage[]

  @@index([towTruckId])
  @@index([status, createdAt])
}

/// One act of consenting to the processing and publication of personal data.
///
/// ## Append-only history, not a flag on TowTruck
///
/// A `hasConsented` boolean would answer "does this driver consent" and nothing
/// else — not when, not to which version, not to what text, and a withdrawal
/// would erase the fact that consent was ever given. The obligation is the
/// opposite: to be able to show, later, that a specific person agreed to a
/// specific wording on a specific date. So every acceptance and every
/// withdrawal is a row, rows are never rewritten, and "does this driver
/// consent right now" is a query over them (see `hasCurrentConsent`).
///
/// ## Nothing was backfilled, and that is the point
///
/// ~100 drivers were already published when this was introduced. The migration
/// creates an empty table and touches nobody: inventing an `acceptedAt` for a
/// driver who never saw a dialog would be manufacturing the exact evidence this
/// table exists to hold honestly. They are asked on their next login instead —
/// `requiresPrivacyConsent` is simply "no row matching the current version",
/// which is true of all of them until each one actually ticks the box.
///
/// ## Two owners, one at a time
///
/// Consent given at registration has no TowTruck to point at — the profile does
/// not exist until a moderator approves the request, and may never exist at
/// all. So it attaches to the `RegistrationRequest`, and `AdminService.approve`
/// re-points it at the truck it created, in the same transaction. The row is
/// the same row throughout: `acceptedAt` still says when the driver actually
/// agreed, not when an admin got round to reviewing them.
///
/// Both columns are nullable because a row has exactly one owner at a time, and
/// the check constraint in the migration enforces that it is exactly one.
model DriverPrivacyConsent {
  id Int @id @default(autoincrement())

  /// Set once the profile exists — at approval for a registration consent,
  /// immediately for an existing driver's. Cascades like every other child of
  /// TowTruck, so deleting a driver deletes their consent history with them:
  /// keeping it would mean retaining personal data about someone whose whole
  /// point in being deleted was that we stop.
  towTruckId Int?
  towTruck   TowTruck? @relation(fields: [towTruckId], references: [id], onDelete: Cascade)

  /// Set instead of `towTruckId` while the request is still pending. Cascade
  /// again: a rejected request is eventually deleted, and consent to publish a
  /// profile that was never published protects nobody and is nobody's record.
  registrationRequestId Int?
  registrationRequest   RegistrationRequest? @relation(fields: [registrationRequestId], references: [id], onDelete: Cascade)

  /// The policy this consent is against — matched literally against
  /// PRIVACY_POLICY_VERSION. A row for '1.1' stops counting the moment that
  /// constant becomes '1.2', which is the whole re-consent mechanism.
  policyVersion String

  /// sha256 of the canonical consent text, hex, computed by the SERVER from its
  /// own copy — never from anything the client sent. 64 hex characters, fixed
  /// width, hence VarChar(64) rather than an unbounded String: the same choice
  /// and the same reasoning as AnalyticsVisitorDay.visitorKey.
  ///
  /// Stored per row rather than derived from `policyVersion` at read time
  /// because the constant will change and the record must not: this column is
  /// what lets a 2026 consent still be checked against the 2026 wording after
  /// the file holding it has moved on.
  consentTextHash String @db.VarChar(64)

  acceptedAt DateTime @default(now())

  /// Set when the driver withdraws. The row is NOT deleted — a withdrawal is
  /// itself a fact worth being able to show, and deleting the acceptance would
  /// destroy the record of the period during which publication was consented
  /// to. A withdrawn row stops satisfying `hasCurrentConsent`, so the driver is
  /// asked again exactly as if they had never consented.
  revokedAt DateTime?

  /// HMAC-SHA256 of the client IP with a server-side secret, hex — never the
  /// address itself. An IP is personal data, and a plain column would mean this
  /// table (whose entire purpose is data-protection compliance) is itself a
  /// store of unnecessary personal data. The keyed hash keeps the only property
  /// that matters for an audit — two consents from the same address match —
  /// while being useless to anyone who obtains a dump without the secret.
  ///
  /// HMAC rather than the plain `sha256(value + pepper)` used for analytics
  /// visitor keys, and the difference matters here: the IPv4 space is 2^32,
  /// small enough to enumerate exhaustively against an unkeyed digest, so a
  /// leaked table plus a leaked pepper would still be reversible in minutes. A
  /// visitor id is a 122-bit random UUID with no such space to search.
  ///
  /// Nullable: a request can legitimately arrive with no resolvable address.
  /// A null means "not captured", which is honest, rather than a fabricated
  /// zero that would look like a real observation.
  ipHash String? @db.VarChar(64)

  /// Truncated to 512 characters before storing — a User-Agent is a client-
  /// controlled string and an unbounded one is an invitation to write megabytes
  /// into an audit table.
  userAgent String? @db.VarChar(512)

  source PrivacyConsentSource

  createdAt DateTime @default(now())

  /// The read this table exists for: "the current, unrevoked consent for this
  /// truck, at this version". `revokedAt` is not in the index because it is
  /// null for almost every row — Postgres reaches the heap for it either way,
  /// and including it would only widen the index.
  @@index([towTruckId, policyVersion])
  /// The same read on the registration side, used by approve() to find the
  /// consent it has to re-point.
  @@index([registrationRequestId])
}

model Review {
  id         Int      @id @default(autoincrement())
  towTruckId Int
  towTruck   TowTruck @relation(fields: [towTruckId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int
  text       String
  cityName   String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([towTruckId])
}

model RegistrationRequest {
  id     Int                @id @default(autoincrement())
  status RegistrationStatus @default(PENDING)

  firstName      String
  lastName       String
  companyName    String?
  phone          String
  secondaryPhone String?
  whatsapp       String?
  telegram       String?
  email          String?

  vehicleBrand         String
  vehicleModel         String?
  vehicleYear          Int
  vehicleType          String
  /// CAPACITY_RANGE_OPTIONS value from frontend constants (e.g. "2-3.5") — required
  capacityRange        String
  /// Same two typed columns as TowTruck, so approve() is a straight copy.
  /// These replaced a single free-text `platformDimensions` ("5.5 մ × 2.2 մ"):
  /// that asked the driver to produce a format instead of two numbers, and
  /// forced a parse step on the way to the live profile — which for a while
  /// simply wasn't there, silently dropping the answer at approval.
  platformLengthM      Float?
  platformWidthM       Float?
  /// The four specialist technical answers — see the identically-named columns
  /// on TowTruck, which these are copied straight into at approval.
  craneCapacityTons    Float?
  craneReachM          Float?
  maxLoadTons          Float?
  platformLoadHeightCm Float?
  winch                Boolean @default(false)
  manipulator          Boolean @default(false)
  /// See TowTruck.wheelSkates — carried over as-is by AdminService.approve()
  wheelSkates          Boolean @default(false)
  /// See TowTruck.doubleDeck — carried over as-is by AdminService.approve()
  doubleDeck           Boolean @default(false)
  /// See TowTruck.towHitch — carried over as-is by AdminService.approve()
  towHitch             Boolean @default(false)
  /// The driver's own claim to «Ծանր տեխնիկայի տեղափոխում».
  ///
  /// This is a REQUEST, not the flag. `TowTruck.heavyEquipment` still means
  /// "what a moderator decided" — approval submits the whole profile as the
  /// reviewer last saw it, so whatever they leave ticked is what goes live, and
  /// a driver's answer never reaches a public page unreviewed. That is what
  /// keeps the self-promotion hole closed now that the question is asked at
  /// sign-up (see backend/src/tow-trucks/vehicle-types.ts).
  heavyEquipment       Boolean @default(false)
  /// See TowTruck.servesAllArmenia — «Ամբողջ Հայաստան» as one answer
  servesAllArmenia     Boolean @default(false)
  // No works24Hours column here — it's just one of the `services` slugs the
  // driver picks (see backend/src/tow-trucks/service-slugs.ts). TowTruck
  // below keeps a real boolean column, but only as a derived sort/filter index.
  /// Same free-form field as TowTruck.workingHoursText — carried over as-is
  /// by AdminService.approve(). Only relevant when "available-24-7" isn't
  /// among `services` (see above).
  workingHoursText     String?

  /// Up to 2 marzes (see CreateRegistrationDto's ArrayMaxSize(2)) — a driver
  /// who covers e.g. Yerevan + Kotayk picks both here, and `citySlugs` then
  /// spans both regions' cities/districts. Was a single `mainRegionSlug`
  /// String; kept as an array even though today's UI caps it at 2, so a future
  /// cap increase is a frontend-only change, not another migration.
  regionSlugs String[]
  citySlugs   String[]
  services    String[]

  /// The same two columns TowTruck has, so approve() is a straight copy —
  /// exactly like platformLengthM/platformWidthM above. See TowTruck.latitude
  /// for why this is two numbers rather than one string, and why the column
  /// is nullable even though CreateRegistrationDto requires it: requests
  /// submitted before this feature existed have none, and they are kept
  /// forever as an audit trail.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  priceCityCallout           Int?
  pricePerKm                 Int?
  priceWaitingPerHour        Int?
  priceNightSurchargePercent Int?
  priceExtraLoading          Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images TowTruckImage[]

  /// The consent ticked in the dialog when this request was submitted, written
  /// in the same transaction as the request itself — a request without one
  /// cannot exist, because `RegistrationService.submit` refuses to create it.
  ///
  /// An array rather than a single relation only because Prisma needs one for
  /// the other side to be optional; in practice there is exactly one row, and
  /// `approve()` re-points it at the TowTruck it creates.
  privacyConsents DriverPrivacyConsent[]

  @@index([status])
}

/// "Ազատ երթուղիներ" — a driver heading somewhere empty posts a route so
/// customers going the same way can find them. Geography here is just slugs
/// (frontend static data), same convention as TowTruck/RegistrationRequest.
model FreeRoute {
  id         Int      @id @default(autoincrement())
  towTruckId Int
  towTruck   TowTruck @relation(fields: [towTruckId], references: [id], onDelete: Cascade)

  startRegionSlug String
  startCitySlug   String
  endRegionSlug   String
  endCitySlug     String

  /// Departure date + time combined. This IS the auto-expiry deadline —
  /// once it passes the cleanup cron flips ACTIVE -> FINISHED, then hard
  /// deletes FINISHED rows after a short grace period (see FreeRoutesService).
  departureAt DateTime

  /// Optional free-text note from the driver, shown on the public card
  /// (e.g. "կարող եմ սպասել կես ժամ")
  description String?

  status    FreeRouteStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([towTruckId])
  @@index([status, departureAt])
}

/// Pre-aggregated, deduplicated counters — ONE row per
/// (tow truck, Armenia calendar day, event type). This is the only table the
/// dashboard and the charts ever read from, which is what keeps them O(days
/// in the selected period) instead of O(events ever recorded).
///
/// `eventCount` is already deduplicated: AnalyticsVisitorDay below guarantees
/// a given visitor can bump a given counter at most once per calendar day, so
/// `eventCount` literally means "how many distinct visitors did this on this
/// day" — never "how many times was the button pressed".
model AnalyticsDailyStat {
  id         Int      @id @default(autoincrement())
  towTruckId Int
  towTruck   TowTruck @relation(fields: [towTruckId], references: [id], onDelete: Cascade)

  /// Date-only (no time, no timezone) — the Armenia (Asia/Yerevan) calendar
  /// day the event happened on, resolved by AnalyticsClock before writing.
  /// Storing a plain DATE rather than a timestamp is what makes "today" mean
  /// the same thing to the dedup key, the aggregate row and the chart axis.
  statDate  DateTime           @db.Date
  eventType AnalyticsEventType

  eventCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Doubles as the UPSERT conflict target (see AnalyticsRepository.recordEvent)
  /// AND as the read index: the leading (towTruckId, statDate) prefix serves
  /// every dashboard/chart query, so no separate read index is needed.
  @@unique([towTruckId, statDate, eventType])
}

/// The deduplication ledger: one row proves "this visitor already triggered
/// this event type for this tow truck on this calendar day". Its unique
/// constraint is what enforces the once-per-day rule at the DATABASE level —
/// not in application code — so two concurrent requests from the same visitor
/// can never both increment the counter (see docs/analytics.md § race
/// conditions).
///
/// Retention: rows older than ANALYTICS_VISITOR_DAY_RETENTION_DAYS are purged
/// by a daily cron. AnalyticsDailyStat keeps full history forever; only this
/// (much larger) table is time-bounded.
model AnalyticsVisitorDay {
  id         Int      @id @default(autoincrement())
  towTruckId Int
  towTruck   TowTruck @relation(fields: [towTruckId], references: [id], onDelete: Cascade)

  statDate  DateTime           @db.Date
  eventType AnalyticsEventType

  /// sha256(rawVisitorId + pepper), hex. The raw cookie value is NEVER stored —
  /// a dump of this table can't be replayed against a visitor's browser, and
  /// can't be joined against any other system's identifiers.
  visitorKey String @db.VarChar(64)

  createdAt DateTime @default(now())

  /// The dedup key. Column order is deliberate: with visitorKey LAST, the same
  /// index also answers "COUNT(DISTINCT visitorKey) WHERE towTruckId = ? AND
  /// statDate BETWEEN ? AND ? AND eventType = ?" as an index-only scan — i.e.
  /// the unique-visitors metric needs no second index and never touches the heap.
  @@unique([towTruckId, statDate, eventType, visitorKey])
  /// Only for the retention purge, which filters on statDate across ALL tow
  /// trucks and therefore cannot use the towTruckId-leading index above.
  @@index([statDate])
}

/// Site-wide counters for the admin panel — the exact same two-table design as
/// AnalyticsDailyStat / AnalyticsVisitorDay above, minus the tow truck.
///
/// Separate tables rather than a nullable `towTruckId` on the existing pair:
/// that column is part of both unique constraints and leads every index, so
/// making it nullable would change the meaning of every driver-facing query and
/// every aggregate already stored. Two small purpose-built tables cost less
/// than one overloaded one.
model SiteDailyStat {
  id Int @id @default(autoincrement())

  statDate  DateTime      @db.Date
  eventType SiteEventType

  eventCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Dedup target of the counter UPSERT, and the read index for the admin panel
  @@unique([statDate, eventType])
}

/// The site-wide half of the deduplication ledger — proves "this visitor already
/// triggered this event today", so one person refreshing the homepage twenty
/// times is one visit. Same retention rule and same daily purge as
/// AnalyticsVisitorDay.
model SiteVisitorDay {
  id Int @id @default(autoincrement())

  statDate  DateTime      @db.Date
  eventType SiteEventType

  /// sha256(rawVisitorId + pepper), hex — same construction, same guarantees
  visitorKey String @db.VarChar(64)

  createdAt DateTime @default(now())

  /// visitorKey last again, so COUNT(DISTINCT visitorKey) over a date range
  /// stays an index-only scan
  @@unique([statDate, eventType, visitorKey])
  @@index([statDate])
}

/// Admin accounts — created only via `npm run admin:create`, no self-registration.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Telegram-based 2FA for admin login (separate dedicated bot from the
  // driver one — see AdminTelegramService) + new-registration notifications.
  // Same linking mechanism as TowTruck.telegramChatId: null until the admin
  // taps a one-time link generated by `npm run admin:telegram-link`. Login
  // stays single-factor (password only) until this is set.
  telegramChatId             BigInt?    @unique
  telegramLinkToken          String?    @unique
  telegramLinkTokenExpiresAt DateTime?
  otps                       AdminOtp[]
}

/// Short-lived 2FA login codes sent to an admin's linked Telegram chat.
///
/// The only OTP table left. `DriverOtp` was its twin until drivers moved to
/// password login; admins keep codes because for them the code is a SECOND
/// factor on top of a password, not the password's replacement.
model AdminOtp {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 hash of the 6-digit code — the raw code is never stored
  codeHash   String
  expiresAt  DateTime
  /// Failed verify attempts against this code — locked out after 5
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}
